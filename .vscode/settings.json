{
  "tailwindCSS.experimental.classRegex": [
    [
      "tv\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]",
      // match variants className
    ]
  ],
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "search.exclude": {
    "**/.specstory/**": true,
    "**/.superpowers/**": true,
    "**/docs/superpowers/**": true,
  },
  // https://biomejs.dev/reference/vscode/#fix-on-save
  "editor.codeActionsOnSave": {
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit",
  },
  // If you want to silent stylistic rules
  // You can put this in your user settings or workspace settings
  "eslint.rules.customizations": [
    {
      "rule": "@stylistic/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "tailwindcss/classnames-order",
      "severity": "off"
    },
    {
      "rule": "antfu/consistent-list-newline",
      "severity": "off"
    },
    {
      "rule": "simple-import-sort/*",
      "severity": "off"
    },
    {
      "rule": "prefer-const",
      "severity": "off"
    },
    {
      "rule": "unused-imports/no-unused-imports",
      "severity": "off"
    },
    {
      "rule": "tailwindcss/classnames-order",
      "severity": "off"
    }
  ],
  "cSpell.words": [
    "yohaku"
  ],
}