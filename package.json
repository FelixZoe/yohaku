{
  "name": "Yohaku",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @yohaku/web build",
    "dev": "pnpm --filter @yohaku/web dev",
    "dev:mobile": "pnpm --filter @yohaku/mobile start",
    "ios": "pnpm --filter @yohaku/mobile ios",
    "lint": "pnpm --filter @yohaku/web lint",
    "oss:ship": "bash ./scripts/ship-oss.sh",
    "postinstall": "node ./scripts/link-yohaku-oss-node-modules.mjs",
    "prepare": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@innei/prettier": "1.0.0",
    "@lobehub/lint": "^2.1.5",
    "@types/node": "26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-xml-parser": "^5.11.2",
    "knip": "^6.38.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "taze": "19.17.1",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --ignore-path ./.gitignore --write "
    ],
    "*.{js,ts,cjs,mjs,jsx,tsx,json}": [
      "eslint --fix"
    ]
  }
}
