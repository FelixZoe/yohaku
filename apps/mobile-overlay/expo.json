{
  "scheme": "yohaku",
  "bundleId": "app.root.mom",
  "version": "1.0.4",
  "icon": "./assets/images/icon.png",
  "iosIcon": "./assets/expo.icon",
  "eas": {
    "build": {
      "production": {
        "env": {
          "EXPO_PUBLIC_API_URL": "https://api.root.mom/api/v3"
        }
      }
    }
  },
  "updates": {
    "enabled": true,
    "url": "https://api.root.mom/ota/manifest",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "requestHeaders": {
      "expo-channel-name": "production"
    }
  }
}